<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GyroHost</AssemblyName>
    <RootNamespace>GyroHost.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 曲线库：OxyPlot.Wpf 2.2.0 支持 net6.0-windows 及以上，与本工程的 net10.0-windows 兼容。 -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GyroHost.Core\GyroHost.Core.csproj" />
  </ItemGroup>

</Project>
