<Window x:Class="GyroHost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:GyroHost.App"
        mc:Ignorable="d"
        Title="陀螺仪 + 电机上位机 — 角度/温度/角速度/电机角度监视（SLCAN）"
        Height="1000" Width="1920" MinHeight="760" MinWidth="1500"
        Background="#F2F3F7" Foreground="#1F1F28"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCDCE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1B4F82" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5A66" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="UnitText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6A6A78" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,0,4" />
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5A66" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F1F28" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ 左侧控制面板 ============================ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>

                <!-- 连接 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="连接（USB-CAN / SLCAN）" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="串口" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Margin="0,3"
                                      ItemsSource="{Binding Ports}"
                                      SelectedItem="{Binding SelectedPort}"
                                      IsEnabled="{Binding CanEditConnectionSettings}" />
                            <Button Grid.Column="2" Content="刷新" Margin="6,3,0,3" Padding="10,4"
                                    Command="{Binding RefreshPortsCommand}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="串口波特率" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1" Margin="0,3"
                                      ItemsSource="{Binding BaudRates}"
                                      SelectedItem="{Binding SelectedBaudRate}"
                                      IsEnabled="{Binding CanEditConnectionSettings}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAN 波特率" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1" Margin="0,3"
                                      ItemsSource="{Binding CanBitRatesKbps}"
                                      SelectedItem="{Binding SelectedCanBitRateKbps}"
                                      IsEnabled="{Binding CanEditConnectionSettings}" />
                        </Grid>

                        <TextBlock Margin="0,6,0,0" Foreground="#6A6A78" TextWrapping="Wrap"
                                   Text="提示：串口波特率与 CAN 波特率是两个不同参数。当前固件为经典 CAN、标准数据帧、1 Mbps（对应 SLCAN 命令 S8）。" />

                        <CheckBox Margin="0,8,0,0" Content="模拟模式（无硬件时使用，走同一套协议解析）"
                                  IsChecked="{Binding UseSimulation}"
                                  IsEnabled="{Binding CanEditConnectionSettings}" />

                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="连接" Margin="0,3,3,3" Padding="8,6" Command="{Binding ConnectCommand}" />
                            <Button Content="断开" Margin="3,3,0,3" Padding="8,6" Command="{Binding DisconnectCommand}" />
                        </UniformGrid>

                        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4" Background="#F7F7FA" BorderBrush="#E2E2EA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectionStateText}" FontWeight="Bold"
                                           Foreground="{Binding ConnectionBrush}" />
                                <TextBlock Text="{Binding ConnectionMessageText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="#4A4A56" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 实时数值 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="实时数值" Style="{StaticResource CardTitle}" />

                        <Border Padding="8,6" CornerRadius="4" Background="#FAFAFD" BorderBrush="#E2E2EA" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="陀螺仪角度：[-180°,180°)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding AngleWrappedText}" Style="{StaticResource ValueText}"
                                               MinWidth="150" TextAlignment="Right" Foreground="#E67E22"
                                               ToolTip="陀螺仪 0x321 角度，协议分辨率 0.00001°（固件按 角度×100000 四舍五入上报），5 位小数即完整精度。" />
                                    <TextBlock Grid.Column="2" Text="°" Style="{StaticResource UnitText}" />
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="电机角度：（相对起点 P0，未取模）" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding MotorAngleText}" Style="{StaticResource ValueText}"
                                               MinWidth="150" TextAlignment="Right" Foreground="#8E44AD"
                                               ToolTip="电机位置 0x0409 换算后的角度：(P − P0) × 0.1 × 360 / (π × D)，P0 为首次有效位置或“电机显示归零”时的位置。无有效反馈或超时时显示 --。" />
                                    <TextBlock Grid.Column="2" Text="°" Style="{StaticResource UnitText}" />
                                </Grid>

                                <TextBlock Margin="0,2,0,0" Foreground="#6A6A78" FontSize="11" TextWrapping="Wrap"
                                           Text="两条角度共用右侧“角度 — 时间”图与同一时间轴；电机角度不乘陀螺仪的 4 倍修正系数。" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="累计角度（板端原始）" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding AngleCumulativeText}" FontSize="16" FontFamily="Consolas"
                                       FontWeight="SemiBold" MinWidth="110" TextAlignment="Right"
                                       ToolTip="保留固件上报的累计角度，不截断、不取模。" />
                            <TextBlock Grid.Column="2" Text="°" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Separator Margin="0,8,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="温度" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding TemperatureText}" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Column="2" Text="℃" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="角速度" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding RateText}" Style="{StaticResource ValueText}"
                                       MinWidth="150" TextAlignment="Right"
                                       ToolTip="协议分辨率 0.00001°/s（固件按 角速度×100000 上报）。注意传感器灵敏度 280 LSB/(°/s)（≈0.0036°/s），后几位是滤波输出而非独立测量分辨率。" />
                            <TextBlock Grid.Column="2" Text="°/s" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Separator Margin="0,8,0,8" />

                        <TextBlock Text="状态" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="校准状态" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CalibrationStateText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="静止状态" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StillLockText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="数据有效" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AngleValidText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="采样间隔" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SampleIntervalText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="清零结果" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ZeroAngleStateText}" Style="{StaticResource InfoValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 电机位置查询（0x0408 查询 / 0x0409 反馈） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="电机位置查询（0x0408 / 0x0409）" Style="{StaticResource CardTitle}" />

                        <Border Padding="8,6" CornerRadius="4" Background="#FFF7E6" BorderBrush="#E8C77A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding MotorProtocolStatusText}" FontWeight="SemiBold"
                                           Foreground="#8A5A00" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MotorMissingFieldsText}" Foreground="#6A4A10"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备号" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding MotorDeviceIdText, Mode=OneWay}"
                                       Style="{StaticResource InfoValue}"
                                       ToolTip="在第二列“电机参数”卡片修改。此值同时用于 0x0408 查询、0x0316 末字节与 0x0413 的 Data[4]。" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="轮径 D" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding MotorWheelDiameterText, Mode=OneWay}"
                                       Style="{StaticResource InfoValue}"
                                       ToolTip="在第二列“电机参数”卡片修改。只用于上位机角度换算，不会自动写回电机；要写入电机请用“写入轮径 0x0408”。" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="查询周期" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Margin="0,2"
                                      ItemsSource="{Binding MotorPollIntervalOptions}"
                                      SelectedItem="{Binding MotorPollIntervalMs}" />
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource UnitText}" />
                        </Grid>

                        <CheckBox Margin="0,6,0,0" Content="启用位置轮询（默认 100 ms，单请求不堆积）"
                                  IsChecked="{Binding MotorPollingEnabled}"
                                  ToolTip="启用后按周期发送 0x0408；同一设备只保留一个待应答请求，超时后才发下一条。" />

                        <Separator Margin="0,8,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="位置原始值（0.1 mm/LSB）" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding MotorRawPositionText}" FontSize="18"
                                       FontFamily="Consolas" FontWeight="Bold" TextAlignment="Right"
                                       TextWrapping="Wrap" MaxWidth="220"
                                       ToolTip="0x0409 中解析出的有符号位置原始值。无有效位置或未启用位置解码时显示 --／“待确认协议”，不会猜值。" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="绝对位移" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding MotorDisplacementText}" Style="{StaticResource ValueText}"
                                       MinWidth="120" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Separator Margin="0,8,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="起点 P0" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MotorP0Text}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="数据有效" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MotorValidText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="查询状态" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MotorQueryStateText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="最新反馈" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MotorLastFeedbackText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="最近 0x0409" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MotorLastRawReplyText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="剩余位移" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MotorRemainingDisplacementText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="最近错误" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MotorErrorText}" Style="{StaticResource InfoValue}" />
                        </Grid>

                        <TextBlock Margin="0,2,0,0" Text="{Binding MotorCountersText}" Foreground="#6A6A78"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />

                        <Button Content="电机显示归零（仅改上位机 P0，不发 CAN）"
                                Style="{StaticResource ActionButton}" Margin="0,6,0,0"
                                Command="{Binding MotorZeroCommand}"
                                ToolTip="把当前有效位置记为新的起点 P0，清空电机曲线并从 0 重新计时。不会向电机发送归零或配置命令。" />

                        <TextBlock Margin="0,4,0,0" Text="{Binding MotorResolutionText}" Foreground="#6A6A78"
                                   TextWrapping="Wrap" FontSize="11" />

                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#8A5A00" FontSize="11"
                                   Text="注意：0x0421 是剩余位移、0x0441 是力矩、0x0381 是心跳，它们都不是当前位置。只有 0x0409 位置应答参与角度换算；查询码不是 0x08 或设备号不符的 0x0409 一律拒绝，不会被猜成位置。若 0x0409 回复不带设备号，按单设备处理，状态栏会注明。" />
                    </StackPanel>
                </Border>

                <!-- 操作 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="操作（接收过程中可用）" Style="{StaticResource CardTitle}" />

                        <Button Content="重置显示数据（清空曲线与缓存，相对时间从 0 开始）"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding ResetDisplayCommand}"
                                ToolTip="只重置上位机显示，不发送任何板端命令，连接与接收保持。" />

                        <Button Content="板端角度清零（发送 0x322 = 02）"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding ZeroAngleCommand}"
                                ToolTip="单次发送标准数据帧 ID=0x322、DLC=1、数据=02；结果以板端回传角度为准。" />

                        <Button Content="重新零偏校准（发送 0x322 = 01）"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding RecalibrateCommand}"
                                ToolTip="单次发送；发送后请保持板子静止，界面会依据回传状态显示校准进度与结果。" />

                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6A6A78"
                                   Text="说明：发送成功仅表示指令已交给适配器；清零与校准的结果以板端后续回传的数据与状态位为准，界面不会把发送成功当成执行成功。" />
                    </StackPanel>
                </Border>

                <!-- 数据保存（CSV） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="数据保存（CSV）" Style="{StaticResource CardTitle}" />

                        <Button Content="保存本段数据（角度/角速度/原始采样/电机）"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding SaveSegmentCommand}"
                                ToolTip="把内存中自上次“重置显示数据”以来的角度（0x321）、角速度（0x323）、原始采样（0x324+0x325）与电机位置导出为 CSV；点击后弹出“另存为”对话框。" />

                        <TextBlock Margin="0,6,0,0" Text="{Binding ExportRangeText}"
                                   Style="{StaticResource InfoValue}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,4,0,0" Text="{Binding ExportStatusText}"
                                   Style="{StaticResource InfoValue}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6A6A78"
                                   Text="说明：角度、角速度、原始采样、电机角度四路数据各保留本帧时间戳，按时间归并成长表（kind 列为 angle / rate / raw / motor），不插值、不补旧值。原始采样行是 0x324+0x325 按同一采样时间戳配对的结果（板端保证同源），其余各列留空；超出 200000 点/路时最早的点会被丢弃。文件为 UTF-8 with BOM，默认保存到 D:\GyroDatamotor。" />
                    </StackPanel>
                </Border>

                <!-- 曲线显示 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="曲线显示" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="时间窗口" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" Margin="0,2"
                                      ItemsSource="{Binding TimeWindowOptions}"
                                      SelectedItem="{Binding SelectedTimeWindowSeconds}" />
                        </Grid>

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource InfoValue}" Text="{Binding AutoFollowText}" TextWrapping="Wrap" />

                        <Button Content="跟随最新数据（自动）" Style="{StaticResource ActionButton}" Margin="0,6,0,0"
                                Command="{Binding RestoreAutoFollowCommand}"
                                ToolTip="立即跳到最新数据并持续跟随。鼠标缩放/拖动会自动暂停跟随。" />

                        <Button Content="恢复默认视角（角度 ±180°）" Style="{StaticResource ActionButton}"
                                Command="{Binding RestoreDefaultViewCommand}"
                                ToolTip="重新开启跟随，并把三张曲线的纵轴恢复到默认范围（角度图回 ±180°）。" />

                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6A6A78"
                                   Text="三张曲线共用同一时间轴；“角度 — 时间”图里同时画陀螺仪角度（橙）和电机角度（紫），两条都按 ±180° 折返，图例标明来源。累计角度看左侧“累计角度”数值。鼠标滚轮缩放、左键拖动平移，之后可用上面的按钮一键回到最新。跨越 ±180°、板端清零、电机反馈超时恢复、电机显示归零、断线续接处曲线都会自动断开，不会画出假线。没有有效的 0x0409 位置反馈时电机角度显示 --，不补假零点。" />
                    </StackPanel>
                </Border>

                <!-- 接收统计 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="接收统计" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="接收帧数" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FrameCountText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="异常帧数" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ErrorCountText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="数据超时" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimeoutText}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="重置丢弃" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DroppedText}" Style="{StaticResource InfoValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 电机原始 CAN 日志 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="电机原始 CAN 日志" Style="{StaticResource CardTitle}" />
                            <Button Grid.Column="1" Content="复制" Padding="8,2" Margin="0,0,6,6"
                                    Command="{Binding CopyMotorRawLogCommand}" />
                            <Button Grid.Column="2" Content="清空" Padding="8,2" Margin="0,0,0,6"
                                    Command="{Binding ClearMotorRawLogCommand}" />
                        </Grid>

                        <ListBox Height="190" FontFamily="Consolas" FontSize="10.5"
                                 ItemsSource="{Binding MotorRawLogLines}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="TX 为 0x0408 位置查询；RX 包含 0x0409，以及 0x0421/0x0441/0x0381。若位置数值与实测不符，用这些原始字节核对回复。" />

                        <TextBlock Margin="0,4,0,0" Foreground="#6A6A78" FontSize="11" TextWrapping="Wrap"
                                   Text="仅保留最近 500 条。每行包含墙钟时间、方向、ID、DLC 和原始数据，可直接复制用于协议确认。" />
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行日志" Style="{StaticResource CardTitle}" />
                            <Button Grid.Column="1" Content="清空" Padding="10,2" Margin="0,0,0,6"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>

                        <ListBox Height="180" FontFamily="Consolas" FontSize="11"
                                 ItemsSource="{Binding LogLines}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ 第二列：电机 ============================ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>

                <!-- 电机参数 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="电机参数（设备号 / 轮径）" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备号" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Margin="0,2" Padding="4,3"
                                     Text="{Binding MotorDeviceIdText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="范围 1..15。同时用于 0x0408 查询/配置的 Data[0]、0x0316 的末字节、0x0413 的 Data[4]。" />
                            <TextBlock Grid.Column="2" Text="1..15" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="轮径 D" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Margin="0,2" Padding="4,3"
                                     Text="{Binding MotorWheelDiameterText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="上位机角度换算：角度 = 位移(mm) × 360 / (π × D)。改这里不会自动写电机；要写入电机请点“写入轮径 0x0408”。" />
                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitText}" />
                        </Grid>

                        <TextBlock Margin="0,6,0,0" Text="{Binding MotorWheelConfigText}" Foreground="#6A6A78"
                                   FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#6A6A78" FontSize="11"
                                   Text="轮径同时用于两处：① 上位机把位置换算成角度；② 点“写入轮径”时按 0x0408 / 0x24 下发（单位 0.01 mm）。修改输入框本身只影响①，不会改写电机。" />
                    </StackPanel>
                </Border>

                <!-- 电机初始化（0x0316 / 0x0408 配轮径 / 0x0413） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="电机初始化（0x0316 / 0x0408 / 0x0413）" Style="{StaticResource CardTitle}" />

                        <Border Padding="8,6" CornerRadius="4" Background="#FFF7E6" BorderBrush="#E8C77A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚠ 这三条帧来自补充资料，不在《电机 CAN 通信协议 V11》表内，且均无应答"
                                           FontWeight="SemiBold" Foreground="#8A5A00" TextWrapping="Wrap" />
                                <TextBlock Foreground="#6A4A10" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="0x0316 的 B4 BF CF AA 00 5F 01 各字节含义未定义（只把末字节当作设备号）；0x0408 / 0x24 的轮径单位按 0.01 mm 处理并连发 3 次；0x0413 的 0x5A 使能 / 0x4A 释放都需要实机对照。" />
                                <TextBlock Foreground="#8A5A00" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="“已发送”只表示命令已交给适配器，不代表电机已执行；结果以电机实际动作与位置反馈为准。" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource ActionButton}" Margin="0,8,0,0"
                                Content="① 参数初始化（0x0316，DLC=8）"
                                Command="{Binding InitMotorParametersCommand}"
                                ToolTip="发送 0x0316：B4 BF CF AA 00 5F 01 + 设备号。用途：配置电机参数 / 建立 PID 基准。无应答。" />

                        <Button Style="{StaticResource ActionButton}" Margin="0,4,0,0"
                                Content="② 写入轮径（0x0408 / 0x24，连发 3 次）"
                                Command="{Binding WriteMotorWheelDiameterCommand}"
                                ToolTip="发送 0x0408：设备号 + 0x24 + u16 小端轮径（0.01 mm）。100.00 mm → 10 27。协议要求连续写 3 次，中间不插延时。" />

                        <Button Style="{StaticResource ActionButton}" Margin="0,4,0,0"
                                Content="③ 上电使能（0x0413 = 0x5A）"
                                Command="{Binding MotorEnableCommand}"
                                ToolTip="发送 0x0413：5A 00 00 00 + 设备号。使能后电机保持锁定/有锁力。" />

                        <Button Style="{StaticResource ActionButton}" Margin="0,4,0,0"
                                Content="下电释放（0x0413 = 0x4A）"
                                Command="{Binding MotorReleaseCommand}"
                                ToolTip="发送 0x0413：4A 00 00 00 + 设备号。释放后电机失去锁力，可能自由滑动；请先确认机构安全。" />

                        <TextBlock Margin="0,8,0,0" Text="{Binding MotorInitStatusText}" Foreground="#1F1F28"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#6A6A78" FontSize="11"
                                   Text="建议顺序：① → ② → ③（本机不自动串联，需逐步点击，便于分步排查）。往复运动中这四条命令全部禁用，只能先“取消运动”。" />
                    </StackPanel>
                </Border>

                <!-- 电机往复运动（0x0413/0x0414/0x0415/0x0416） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="电机运动控制（正转 → 返回）" Style="{StaticResource CardTitle}" />

                        <Border Padding="8,6" CornerRadius="4" Background="#FFF7E6" BorderBrush="#E8C77A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚠ 运动指令只按协议表实现，尚未实机验证" FontWeight="SemiBold"
                                           Foreground="#8A5A00" TextWrapping="Wrap" />
                                <TextBlock Foreground="#6A4A10" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="0x0416 的符号/单位、0x0413 的 0x5A/0x4A、0x041A 的 DLC 都还没有实机对照。首次试车请把速度/加速度设小，并随时准备点“取消”。" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="速度" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Margin="0,2" Padding="4,3"
                                     Text="{Binding MotorSpeedText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="0x0415 的 Data[0..3]（单位 0.1 mm/s）。默认 100 mm/s。" />
                            <TextBlock Grid.Column="2" Text="mm/s" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="加速度" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Margin="0,2" Padding="4,3"
                                     Text="{Binding MotorAccelerationText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="0x0414 的 Data[0..3]（协议表单位 0.1 mm）。默认 500 mm/s²。" />
                            <TextBlock Grid.Column="2" Text="mm/s²" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="往复轮数" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Margin="0,2" Padding="4,3"
                                     Text="{Binding MotorCycleRounds, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="每个角度按钮都执行“正转 → 返回”一次为一轮；默认 3 轮，范围 1..50。" />
                            <TextBlock Grid.Column="2" Text="轮" Style="{StaticResource UnitText}" />
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="停顿时长" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Margin="0,2" Padding="4,3"
                                     Text="{Binding MotorDwellSecondsText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="每轮正转到达目标角度后停顿多久再返程（秒），默认 1 s；范围 0..60，0 表示不停顿。返回起点后不停顿。" />
                            <TextBlock Grid.Column="2" Text="s" Style="{StaticResource UnitText}" />
                        </Grid>

                        <TextBlock Margin="0,6,0,0" Text="{Binding MotorCycleSummaryText}" Foreground="#6A6A78"
                                   FontSize="11" TextWrapping="Wrap" />

                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <Button Content="90°" Margin="0,0,4,0" Padding="6,6"
                                    Command="{Binding RunMotorCycleCommand}" CommandParameter="90" />
                            <Button Content="180°" Margin="2,0,2,0" Padding="6,6"
                                    Command="{Binding RunMotorCycleCommand}" CommandParameter="180" />
                            <Button Content="360°" Margin="2,0,2,0" Padding="6,6"
                                    Command="{Binding RunMotorCycleCommand}" CommandParameter="360" />
                            <Button Content="720°" Margin="4,0,0,0" Padding="6,6"
                                    Command="{Binding RunMotorCycleCommand}" CommandParameter="720" />
                        </UniformGrid>

                        <Button Content="取消运动（不撤回已发出的指令）"
                                Style="{StaticResource ActionButton}" Margin="0,6,0,0"
                                Command="{Binding CancelMotorCycleCommand}" />

                        <TextBlock Margin="0,6,0,0" Text="{Binding MotorMotionStatusText}" Foreground="#1F1F28"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#6A6A78" FontSize="11"
                                   Text="流程：正转 → 停顿 → 返回 → 停顿。两端默认停3秒，可调；往复过程中不重新校准、不清零。驱动反馈连续3个新鲜位置在±0.25°内才判到位，这不代表实际机械回零已验证。返回停靠至少1秒且陀螺仪锁定后，日志记录相对整批起点的累计角度残差；短停或数据无效时不判合格。单段超时30秒，反馈中断超过600 ms判失败；结束保持电机使能。" />

                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#6A6A78" FontSize="11">
                            <Run Text="最近参数 ACK（0x041A）：" />
                            <Run Text="{Binding MotorAckText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ 右侧曲线 ============================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <oxy:PlotView x:Name="AnglePlotView" Model="{Binding AngleChart.Model}" Background="Transparent"
                              PreviewMouseDown="OnPlotPreviewMouseDown"
                              PreviewMouseWheel="OnPlotPreviewMouseWheel" />
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <oxy:PlotView x:Name="TemperaturePlotView" Model="{Binding TemperatureChart.Model}" Background="Transparent"
                              PreviewMouseDown="OnPlotPreviewMouseDown"
                              PreviewMouseWheel="OnPlotPreviewMouseWheel" />
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <oxy:PlotView x:Name="RatePlotView" Model="{Binding RateChart.Model}" Background="Transparent"
                              PreviewMouseDown="OnPlotPreviewMouseDown"
                              PreviewMouseWheel="OnPlotPreviewMouseWheel" />
            </Border>
        </Grid>
    </Grid>
</Window>
